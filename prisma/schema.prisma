generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model users {
  id                                            Int             @id @default(autoincrement())
  name                                          String          @unique
  fullname                                      String
  avatar                                        String?
  email                                         String          @unique
  role_id                                       Int?
  skpd_id                                       Int?
  password                                      String
  token                                         String?
  session                                       DateTime?
  status                                        Boolean         @default(true)
  created_at                                    DateTime        @default(now())
  updated_at                                    DateTime        @updatedAt
  authoredRoles                                 role[]          @relation("AuthorRole")
  authoredSkpd                                  skpd[]          @relation("AuthorSkpd")
  userchangelog_userchangelog_changed_byTousers userchangelog[] @relation("userchangelog_changed_byTousers")
  userchangelog_userchangelog_user_idTousers    userchangelog[] @relation("userchangelog_user_idTousers")
  userloginlog                                  userloginlog[]
  userRole                                      role?           @relation(fields: [role_id], references: [kode], onDelete: NoAction, onUpdate: NoAction)
  userSkpd                                      skpd?           @relation(fields: [skpd_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([role_id], map: "users_role_id_fkey")
  @@index([skpd_id], map: "users_skpd_id_fkey")
}

model role {
  id         Int      @id @default(autoincrement())
  kode       Int      @unique
  name       String
  author_id  Int?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  author     users?   @relation("AuthorRole", fields: [author_id], references: [id])
  users      users[]

  @@index([author_id], map: "role_author_id_fkey")
}

model periode {
  id             Int              @id @default(autoincrement())
  mulai          Int
  akhir          Int
  status         Boolean          @default(true)
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt
  skpd_periode   skpd_periode[]
  wSkpd          w_skpd_periode[]
  x_skpd_periode x_skpd_periode[]

  @@unique([mulai, akhir])
}

model skpd {
  id             Int              @id @default(autoincrement())
  kode           String           @unique
  name           String
  shortname      String?
  author_id      Int?
  status         Boolean          @default(true)
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt
  author         users?           @relation("AuthorSkpd", fields: [author_id], references: [id])
  skpd_periode   skpd_periode[]
  users          users[]
  wSkpdPeriodes  w_skpd_periode[]
  x_skpd_periode x_skpd_periode[]

  @@index([author_id], map: "skpd_author_id_fkey")
}

model skpd_periode {
  id            Int             @id @default(autoincrement())
  skpd_id       Int
  periode_id    Int
  status        Boolean         @default(true)
  created_at    DateTime        @default(now())
  updated_at    DateTime        @updatedAt
  indikator     indikator[]
  outcome       outcome[]
  paguSkpd      pagu_skpd[]
  paguindikatif paguindikatif[]
  periode       periode         @relation(fields: [periode_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  skpd          skpd            @relation(fields: [skpd_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([skpd_id, periode_id])
  @@index([periode_id], map: "skpd_periode_periode_id_fkey")
}

model pagu_skpd {
  id              Int          @id @default(autoincrement())
  skpd_periode_id Int
  tahun           Int
  tahun_ke        Int
  pagu            Decimal?     @db.Decimal(18, 2)
  status          Boolean      @default(true)
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
  skpdPeriode     skpd_periode @relation(fields: [skpd_periode_id], references: [id], onDelete: Cascade)

  @@index([skpd_periode_id], map: "pagu_skpd_skpd_periode_id_fkey")
}

model master {
  id            Int             @id @default(autoincrement())
  parent_id     Int?
  type          String
  kode          String
  name          String          @db.Text
  status        Boolean         @default(true)
  created_at    DateTime        @default(now())
  updated_at    DateTime        @updatedAt
  indikator     indikator[]
  logmaster     logmaster[]
  parent        master?         @relation("MasterChildren", fields: [parent_id], references: [id])
  children      master[]        @relation("MasterChildren")
  outcome       outcome[]
  paguindikatif paguindikatif[]
  pagukegiatan  pagukegiatan[]
  paguprogram   paguprogram[]

  @@unique([parent_id, kode, type])
}

model outcome {
  id               Int               @id @default(autoincrement())
  skpd_periode_id  Int
  id_master        Int
  outcome          String            @db.Text
  status           Boolean           @default(true)
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt
  indikatoroutcome indikatoroutcome?
  master           master            @relation(fields: [id_master], references: [id], onDelete: Cascade)
  skpdPeriode      skpd_periode      @relation(fields: [skpd_periode_id], references: [id], onDelete: Cascade)

  @@index([id_master], map: "outcome_id_master_fkey")
  @@index([skpd_periode_id], map: "outcome_skpd_periode_id_fkey")
}

model indikator {
  id                Int                @id @default(autoincrement())
  skpd_periode_id   Int
  master_id         Int
  label_nasional_id Int?
  label_prov_id     Int?
  label_kab_id      Int?
  name              String             @db.Text
  satuan            String
  lokasi            String?
  jenis_satuan      SatuanAkumulasi    @default(akumulatif)
  status            Boolean            @default(true)
  created_at        DateTime           @default(now())
  updated_at        DateTime           @updatedAt
  labelKabId        Int?
  labelKab          labelkab?          @relation(fields: [labelKabId], references: [id])
  master            master             @relation(fields: [master_id], references: [id], onDelete: Cascade)
  skpdPeriode       skpd_periode       @relation(fields: [skpd_periode_id], references: [id], onDelete: Cascade)
  rincianindikator  rincianindikator[]

  @@unique([skpd_periode_id, master_id])
  @@index([labelKabId], map: "indikator_labelKabId_fkey")
  @@index([master_id], map: "indikator_master_id_fkey")
}

model catatan_eval {
  id           Int       @id @default(autoincrement())
  skpd_periode Int
  type         jenisEval
  pendorong    String?   @db.Text
  penghambat   String?   @db.Text
  tl_1         String?   @db.Text
  tl_2         String?   @db.Text
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@unique([skpd_periode, type])
}

model w_skpd_periode {
  id         Int        @id @default(autoincrement())
  skpd_id    Int
  periode_id Int
  status     Boolean    @default(true)
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
  wMasters   w_master[]
  periode    periode    @relation(fields: [periode_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  skpd       skpd       @relation(fields: [skpd_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([skpd_id, periode_id])
  @@index([periode_id], map: "w_skpd_periode_periode_id_fkey")
}

model w_master {
  id         Int            @id @default(autoincrement())
  kode       String?
  skpdId     Int
  type       EntityType
  name       String         @db.Text
  status     Boolean        @default(true)
  created_at DateTime       @default(now())
  updated_at DateTime       @updatedAt
  skpd       w_skpd_periode @relation(fields: [skpdId], references: [id], onDelete: Cascade)
  uraian     w_uraian[]

  @@index([skpdId], map: "w_master_skpdId_fkey")
}

model w_uraian {
  id                      Int                       @id @default(autoincrement())
  master_id               Int
  name                    String                    @db.Text
  satuan                  String
  base_line               String
  perhitungan             String                    @default("akumulatif")
  is_iku                  Boolean
  w_targetrealisasiuraian w_targetrealisasiuraian[]
  master                  w_master                  @relation(fields: [master_id], references: [id], onDelete: Cascade)

  @@index([master_id], map: "w_uraian_master_id_fkey")
}

model x_skpd_periode {
  id              Int               @id @default(autoincrement())
  skpd_id         Int
  periode_id      Int
  status          Boolean           @default(true)
  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt
  indikator       x_indikator[]
  outcome         x_outcome[]
  paguSkpd        x_pagu_skpd[]
  x_paguindikatif x_paguindikatif[]
  periode         periode           @relation(fields: [periode_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  skpd            skpd              @relation(fields: [skpd_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([skpd_id, periode_id])
  @@index([periode_id], map: "x_skpd_periode_periode_id_fkey")
}

model x_pagu_skpd {
  id              Int            @id @default(autoincrement())
  skpd_periode_id Int
  tahun           Int
  tahun_ke        Int
  pagu            Decimal?       @db.Decimal(18, 2)
  status          Boolean        @default(true)
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt
  skpdPeriode     x_skpd_periode @relation(fields: [skpd_periode_id], references: [id], onDelete: Cascade)

  @@index([skpd_periode_id], map: "x_pagu_skpd_skpd_periode_id_fkey")
}

model x_master {
  id              Int               @id @default(autoincrement())
  parent_id       Int?
  type            String
  kode            String
  name            String            @db.Text
  status          Boolean           @default(true)
  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt
  indikator       x_indikator[]
  x_logmaster     x_logmaster[]
  parent          x_master?         @relation("MasterChildren", fields: [parent_id], references: [id])
  children        x_master[]        @relation("MasterChildren")
  outcome         x_outcome[]
  x_paguindikatif x_paguindikatif[]
  x_pagukegiatan  x_pagukegiatan[]
  x_paguprogram   x_paguprogram[]

  @@unique([parent_id, kode, type])
}

model x_outcome {
  id                 Int                 @id @default(autoincrement())
  skpd_periode_id    Int
  id_master          Int
  outcome            String              @db.Text
  status             Boolean             @default(true)
  created_at         DateTime            @default(now())
  updated_at         DateTime            @updatedAt
  x_indikatoroutcome x_indikatoroutcome?
  master             x_master            @relation(fields: [id_master], references: [id], onDelete: Cascade)
  skpdPeriode        x_skpd_periode      @relation(fields: [skpd_periode_id], references: [id], onDelete: Cascade)

  @@index([id_master], map: "x_outcome_id_master_fkey")
  @@index([skpd_periode_id], map: "x_outcome_skpd_periode_id_fkey")
}

model x_indikator {
  id                 Int                  @id @default(autoincrement())
  skpd_periode_id    Int
  master_id          Int
  label_nasional_id  Int?
  label_prov_id      Int?
  label_kab_id       Int?
  name               String               @db.Text
  satuan             String
  lokasi             String?
  jenis_satuan       SatuanAkumulasi      @default(akumulatif)
  status             Boolean              @default(true)
  created_at         DateTime             @default(now())
  updated_at         DateTime             @updatedAt
  labelKabId         Int?
  labelKab           x_labelkab?          @relation(fields: [labelKabId], references: [id])
  master             x_master             @relation(fields: [master_id], references: [id], onDelete: Cascade)
  skpdPeriode        x_skpd_periode       @relation(fields: [skpd_periode_id], references: [id], onDelete: Cascade)
  x_rincianindikator x_rincianindikator[]

  @@unique([skpd_periode_id, master_id])
  @@index([labelKabId], map: "x_indikator_labelKabId_fkey")
  @@index([master_id], map: "x_indikator_master_id_fkey")
}

model x_catatan_eval {
  id           Int         @id @default(autoincrement())
  skpd_periode Int
  type         x_jenisEval
  pendorong    String?     @db.Text
  penghambat   String?     @db.Text
  tl_1         String?     @db.Text
  tl_2         String?     @db.Text
  created_at   DateTime    @default(now())
  updated_at   DateTime    @updatedAt

  @@unique([skpd_periode, type])
}

model dak_tahun {
  id         Int      @id @default(autoincrement())
  tahun      Int      @unique
  keterangan String?
  status     Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model dak_master {
  id          Int           @id @default(autoincrement())
  kode        String
  parent_id   Int?
  type        EntityType
  name        String        @db.Text
  status      Boolean       @default(true)
  created_at  DateTime      @default(now())
  updated_at  DateTime      @updatedAt
  parent      dak_master?   @relation("MasterChildren", fields: [parent_id], references: [id])
  children    dak_master[]  @relation("MasterChildren")
  fisikIdents fisik_ident[]

  @@index([parent_id], map: "dak_master_parent_id_fkey")
}

model dak_opd {
  id          Int           @id @default(autoincrement())
  kode        String?
  shortname   String?
  fullname    String        @db.Text
  status      Boolean       @default(true)
  created_at  DateTime      @default(now())
  updated_at  DateTime      @updatedAt
  fisikIdents fisik_ident[]
}

model dak_jenis {
  id           Int            @id @default(autoincrement())
  kode         Int            @unique
  jenis        String
  keterangan   String?        @db.Text
  created_at   DateTime       @default(now())
  updated_at   DateTime       @updatedAt
  dakBerkas    dak_berkas[]
  bidang       dak_bidang[]
  masalah      dak_masalah[]
  dak_subjenis dak_subjenis[]
}

model dak_bidang {
  id            Int             @id @default(autoincrement())
  jenis_dak     Int?
  name          String
  keterangan    String?         @db.Text
  status        Boolean         @default(true)
  created_at    DateTime        @default(now())
  update_at     DateTime        @updatedAt
  dakJenis      dak_jenis?      @relation(fields: [jenis_dak], references: [kode])
  dak_subbidang dak_subbidang[]

  @@index([jenis_dak], map: "dak_bidang_jenis_dak_fkey")
}

model dak_masalah {
  id         Int        @id @default(autoincrement())
  jenis_dak  Int?
  name       String
  keterangan String?    @db.Text
  status     Boolean    @default(true)
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
  dakJenis   dak_jenis? @relation(fields: [jenis_dak], references: [kode])

  @@index([jenis_dak], map: "dak_masalah_jenis_dak_fkey")
}

model dak_berkas {
  id            Int             @id @default(autoincrement())
  jenis_dak     Int
  no            Int             @unique
  group         jenisBerkas
  name          String          @db.Text
  keterangan    String?         @db.Text
  status        Boolean         @default(true)
  create_at     DateTime        @default(now())
  updated_at    DateTime        @updatedAt
  jenis         dak_jenis       @relation(fields: [jenis_dak], references: [kode], onDelete: NoAction)
  fisikDokumens fisik_dokumen[]

  @@index([jenis_dak], map: "dak_berkas_jenis_dak_fkey")
}

model fisik_ident {
  id              Int               @id @default(autoincrement())
  sub_jenis       Int
  sub_bidang_dak  Int
  tahun           Int
  opd_id          Int
  bidangOpd       String
  sub_kegiatan    Int
  catatan         String?           @db.Text
  verifikasi      verifStatus       @default(di_periksa)
  create_at       DateTime          @default(now())
  updated_at      DateTime          @updatedAt
  detail          fisik_detail?
  fisikDokumens   fisik_dokumen[]
  opd             dak_opd           @relation(fields: [opd_id], references: [id], onDelete: NoAction)
  subBidang       dak_subbidang     @relation(fields: [sub_bidang_dak], references: [id], onDelete: NoAction)
  subJenis        dak_subjenis      @relation(fields: [sub_jenis], references: [id], onDelete: NoAction)
  subKegiatan     dak_master        @relation(fields: [sub_kegiatan], references: [id], onDelete: NoAction)
  mekanisme       fisik_mekanisme?
  fisikRealisasis fisik_realisasi[]

  @@index([opd_id], map: "fisik_ident_opd_id_fkey")
  @@index([sub_bidang_dak], map: "fisik_ident_sub_bidang_dak_fkey")
  @@index([sub_jenis], map: "fisik_ident_sub_jenis_fkey")
  @@index([sub_kegiatan], map: "fisik_ident_sub_kegiatan_fkey")
}

model fisik_detail {
  id              Int         @id @default(autoincrement())
  id_ident        Int         @unique
  nama_paket      String      @db.Text
  detail_paket    String      @db.Text
  volume          Float?
  satuan          String?
  estimasi        String?
  jumlah_penerima String?
  anggaran        Decimal?    @db.Decimal(18, 2)
  des_kel         String?
  kec             String?
  bujur           String      @db.LongText
  lintang         String      @db.LongText
  foto            String?
  create_at       DateTime    @default(now())
  updated_at      DateTime    @updatedAt
  ident           fisik_ident @relation(fields: [id_ident], references: [id], onDelete: NoAction)
}

model fisik_mekanisme {
  id         Int              @id @default(autoincrement())
  id_ident   Int              @unique
  mekanisme  methodMekanisme?
  uang       Decimal?         @db.Decimal(18, 2)
  volume     Float?
  metode     String?
  create_at  DateTime         @default(now())
  updated_at DateTime         @updatedAt
  ident      fisik_ident      @relation(fields: [id_ident], references: [id], onDelete: NoAction)
}

model fisik_dokumen {
  id           Int         @id @default(autoincrement())
  id_berkas    Int
  id_ident     Int
  file         String?     @db.Text
  Kesesuaian   String?
  Waktu        DateTime?
  Keterangan   String?     @db.Text
  pesan        String?     @db.Text
  create_at    DateTime    @default(now())
  updated_at   DateTime    @updatedAt
  jenis_berkas dak_berkas  @relation(fields: [id_berkas], references: [id], onDelete: NoAction)
  ident        fisik_ident @relation(fields: [id_ident], references: [id], onDelete: NoAction)

  @@unique([id_berkas, id_ident])
  @@index([id_ident], map: "fisik_dokumen_id_ident_fkey")
}

model fisik_realisasi {
  id                Int                      @id @default(autoincrement())
  id_ident          Int
  triwulan          Int
  fisik             Float?                   @default(0)
  anggaran          Decimal?                 @default(0.00) @db.Decimal(18, 2)
  sasaran_lokasi    Boolean?
  kesesuaian_juknis Boolean?
  kodefikasi        String?
  masalah_lain      String?
  catatan           String?                  @db.Text
  kunci             Boolean                  @default(false)
  disetujui         Boolean                  @default(false)
  created_at        DateTime                 @default(now())
  updated_at        DateTime                 @updatedAt
  masalah           fisik_masalah_realisasi?
  ident             fisik_ident              @relation(fields: [id_ident], references: [id], onDelete: NoAction)

  @@index([id_ident], map: "fisik_realisasi_id_ident_fkey")
}

model fisik_masalah_realisasi {
  id           Int             @id @default(autoincrement())
  id_realisasi Int             @unique
  masalah      String?         @db.LongText
  masalah_lain String?         @db.Text
  file_masalah String?         @db.LongText
  created_at   DateTime        @default(now())
  updated_at   DateTime        @updatedAt
  realisasi    fisik_realisasi @relation(fields: [id_realisasi], references: [id], onDelete: NoAction)
}

model capaiantriwulan {
  id                  Int                  @id @default(autoincrement())
  rincianIndikator_id Int
  triwulan            Int
  capaian             Float?
  status              Boolean              @default(true)
  created_at          DateTime             @default(now())
  updated_at          DateTime
  rincianindikator    rincianindikator     @relation(fields: [rincianIndikator_id], references: [id], onDelete: Cascade, map: "capaianTriwulan_rincianIndikator_id_fkey")
  capaiantriwulanlog  capaiantriwulanlog[]

  @@index([rincianIndikator_id], map: "capaianTriwulan_rincianIndikator_id_fkey")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model capaiantriwulanlog {
  id              Int              @id @default(autoincrement())
  capaian_id      Int?
  user_id         Int?
  action          String
  old_data        String?          @db.LongText
  new_data        String?          @db.LongText
  created_at      DateTime         @default(now())
  capaiantriwulan capaiantriwulan? @relation(fields: [capaian_id], references: [id], onDelete: Cascade, map: "capaianTriwulanLog_capaian_id_fkey")

  @@index([capaian_id], map: "capaianTriwulanLog_capaian_id_fkey")
}

model dak_subbidang {
  id           Int           @id @default(autoincrement())
  dak_bidangId Int?
  name         String
  keterangan   String?       @db.Text
  status       Boolean       @default(true)
  created_at   DateTime      @default(now())
  update_at    DateTime
  dak_bidang   dak_bidang?   @relation(fields: [dak_bidangId], references: [id], map: "dak_subBidang_dak_bidangId_fkey")
  ident_fisik  fisik_ident[]

  @@index([dak_bidangId], map: "dak_subBidang_dak_bidangId_fkey")
}

model dak_subjenis {
  id          Int           @id @default(autoincrement())
  jenis_dak   Int?
  nama        String
  keterangan  String?       @db.Text
  status      Boolean       @default(true)
  created_at  DateTime      @default(now())
  updated_at  DateTime
  dak_jenis   dak_jenis?    @relation(fields: [jenis_dak], references: [kode], map: "dak_subJenis_jenis_dak_fkey")
  ident_fisik fisik_ident[]

  @@index([jenis_dak], map: "dak_subJenis_jenis_dak_fkey")
}

model indikatoroutcome {
  id                     Int                           @id @default(autoincrement())
  outcome_id             Int                           @unique(map: "indikatorOutcome_outcome_id_key")
  nama                   String                        @db.Text
  satuan                 String?
  status                 Boolean                       @default(true)
  jenis_satuan           indikatoroutcome_jenis_satuan @default(akumulatif)
  created_at             DateTime                      @default(now())
  updated_at             DateTime
  outcome                outcome                       @relation(fields: [outcome_id], references: [id], onDelete: Cascade, map: "indikatorOutcome_outcome_id_fkey")
  targetindikatoroutcome targetindikatoroutcome[]
}

model labelkab {
  id              Int         @id @default(autoincrement())
  skpd_periode_id Int
  poin            Int
  nama            String      @db.Text
  status          Boolean     @default(true)
  created_at      DateTime    @default(now())
  updated_at      DateTime
  indikator       indikator[]
}

model labelnasional {
  id              Int      @id @default(autoincrement())
  skpd_periode_id Int
